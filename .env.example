# ==============================================================================
# OTIUM — Sistem Manajemen Cuti Karyawan
# Template Environment Variables (.env.example)
#
# Salin file ini menjadi `.env` atau `.env.local` lalu sesuaikan nilainya.
# JANGAN PERNAH meng-commit file `.env` asli ke repositori Git.
# ==============================================================================

# Koneksi PostgreSQL (format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/otium_db"

# Kunci rahasia penandatanganan JWT sesi (minimal 32 karakter acak yang kuat)
JWT_SECRET="ganti_dengan_string_acak_minimal_32_karakter_untuk_jwt_otium"
